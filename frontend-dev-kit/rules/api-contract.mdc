description: Trust the API contract. One zod schema per server entity; an invalid body notifies and returns null. Do not restate options already set on the shared HTTP client.
globs: ["**/api/**/*.{ts,tsx}", "**/hooks/**/*.{ts,tsx}"]
alwaysApply: false
