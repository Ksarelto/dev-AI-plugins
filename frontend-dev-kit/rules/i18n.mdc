description: Every user-visible string comes from typed i18n keys — shared copy in shared/lib/i18n/locales/common, slice copy in that slice's locales/. No hardcoded strings and no string-map objects.
globs: ["**/*.tsx", "**/locales/**/*.{json,ts}", "**/constants.ts", "**/config/**/*.ts", "**/model/**/*.ts", "**/models/**/*.ts"]
alwaysApply: false
