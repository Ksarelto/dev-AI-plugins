description: Component folders and files are kebab-case (button.tsx, custom-button.tsx); the export stays PascalCase.
globs: ["**/features/**/ui/**/*.{ts,tsx}", "**/widgets/**/ui/**/*.{ts,tsx}", "**/entities/**/ui/**/*.{ts,tsx}", "**/shared/ui/**/*.{ts,tsx}"]
alwaysApply: false
