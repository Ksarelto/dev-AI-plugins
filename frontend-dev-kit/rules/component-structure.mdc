description: Component folders and files are kebab-case (button.tsx, custom-button.tsx); the export stays PascalCase. index.ts exports only what an outside file imports.
globs: ["**/features/**/ui/**/*.{ts,tsx}", "**/widgets/**/ui/**/*.{ts,tsx}", "**/entities/**/ui/**/*.{ts,tsx}", "**/pages/**/ui/**/*.{ts,tsx}", "**/shared/ui/**/*.{ts,tsx}"]
alwaysApply: false
