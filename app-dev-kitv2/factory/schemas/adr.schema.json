{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "factory/adr",
  "title": "ADR front matter",
  "type": "object",
  "required": [
    "id",
    "title",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ADR-\\d{3}$"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "superseded"
      ]
    },
    "feature": {
      "type": "string",
      "pattern": "^FEAT-\\d{3}$"
    },
    "supersedes": {
      "type": "string",
      "pattern": "^ADR-\\d{3}$"
    }
  }
}
