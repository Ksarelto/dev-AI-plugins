{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "factory/pack",
  "title": "Context pack front matter",
  "type": "object",
  "required": [
    "pack_id",
    "feature",
    "stage",
    "agent",
    "subagent_type",
    "model",
    "attempt",
    "budget_tokens",
    "read_allowlist_max",
    "write_allow"
  ],
  "properties": {
    "pack_id": {
      "type": "string"
    },
    "feature": {
      "type": "string",
      "pattern": "^FEAT-\\d{3}$"
    },
    "stage": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "subagent_type": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "model": {
      "enum": [
        "opus",
        "sonnet",
        "haiku"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "rung": {
      "type": "integer"
    },
    "budget_tokens": {
      "type": "integer"
    },
    "estimated_tokens": {
      "type": "integer"
    },
    "read_allowlist_max": {
      "type": "integer"
    },
    "write_allow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills_required": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "stack skills the dispatch must load (Skill tool) before it writes; from the stack's per-task-type skills"
    },
    "skill_files": {
      "type": "array",
      "description": "SKILL.md path and hash for each required skill. Cursor logs a Read of the path as a load; the agent copies inline:name@hash into skills_loaded.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "hash"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "hash": { "type": "string" }
        }
      }
    },
    "read_deny": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "index_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "context_degraded": {
      "type": "boolean"
    }
  }
}
