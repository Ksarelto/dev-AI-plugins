{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "factory/commit-plan",
  "title": "08-delivery/commits.yaml \u2014 written by the release manager, executed by the engine",
  "type": "object",
  "required": [
    "feature",
    "commits"
  ],
  "properties": {
    "feature": {
      "type": "string",
      "pattern": "^FEAT-\\d{3}$"
    },
    "commits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "message",
          "files"
        ],
        "properties": {
          "task": {
            "type": "string",
            "pattern": "^TASK-\\d{3}$"
          },
          "message": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
