{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "factory/role",
  "title": "role.yaml \u2014 the role contract implemented by a role pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "task_types",
    "agents",
    "gates",
    "requires"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "default_stack": {
      "type": "string"
    },
    "task_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "task types the planner may route to this role"
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builder",
        "test_author"
      ],
      "properties": {
        "builder": {
          "type": "string"
        },
        "test_author": {
          "type": "string"
        },
        "auditor": {
          "type": "string"
        },
        "prototyper": {
          "type": "string"
        },
        "extra": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "builders": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "task type \u2192 specialist builder agent (green phase); other types use builder"
        },
        "architect": {
          "type": "string",
          "description": "joins the architecture stage (role:architect) for this role's design"
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "red",
        "impl"
      ],
      "properties": {
        "red": {
          "type": "string"
        },
        "impl": {
          "type": "string"
        },
        "audits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "description": "extra gate-impl steps for this role: a stack command or a node script in the role pack",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "oneOf": [
              {
                "required": [
                  "command"
                ]
              },
              {
                "required": [
                  "node"
                ]
              }
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "command": {
                "type": "string",
                "description": "a stack.yaml command, e.g. eval"
              },
              "node": {
                "type": "string",
                "description": "a script path relative to the role pack; run in the role's folder with --project <role folder> --files <task files relative to it>"
              },
              "task_types": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "only for these task types (default: all)"
              },
              "report": {
                "type": "boolean",
                "description": "the command writes a Vitest JSON report to {report}; failed tests fail the gate"
              },
              "allow_skipped": {
                "type": "boolean",
                "description": "skipped tests or an empty report pass (default false); a project can set quality.allow_skipped_checks"
              }
            }
          }
        }
      }
    },
    "budgets": {
      "type": "object"
    },
    "requires": {
      "type": "object",
      "properties": {
        "factory": {
          "type": "string"
        }
      },
      "required": [
        "factory"
      ],
      "additionalProperties": true
    }
  }
}
