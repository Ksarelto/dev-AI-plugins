{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "factory/event",
  "title": "One line of events.jsonl",
  "type": "object",
  "required": [
    "ts",
    "type"
  ],
  "properties": {
    "ts": {
      "type": "string"
    },
    "type": {
      "enum": [
        "init",
        "intake",
        "feature",
        "dispatch",
        "envelope",
        "gate",
        "verdict",
        "advance",
        "human",
        "note",
        "halt",
        "register",
        "digest",
        "budget",
        "waiver",
        "resize",
        "error"
      ]
    },
    "feature": {
      "type": "string"
    },
    "stage": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "model": {
      "type": "string"
    }
  }
}
