{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "factory/prototype-screen-note",
  "title": "02b-prototype/screens/<id>.yaml \u2014 what the prototyper learned building one screen",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screen",
    "stories",
    "states"
  ],
  "properties": {
    "screen": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^STORY-\\d{4}$"
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acs_shown": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AC-\\d{4}$"
      },
      "description": "ACs the page lets a person try"
    },
    "spec_delta": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "change",
          "breaking"
        ],
        "properties": {
          "change": {
            "type": "string",
            "minLength": 5
          },
          "breaking": {
            "type": "boolean",
            "description": "true when the approved spec must change"
          },
          "kind": {
            "enum": [
              "validated",
              "invalidated",
              "discovered"
            ],
            "description": "validated: the prototype confirms an AC; invalidated: an AC does not work as written; discovered: a need no AC covers"
          },
          "affects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "needs_classes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "classes the designer's CSS lacks (the designer adds them on revision)"
    },
    "notes": {
      "type": "string"
    }
  }
}
