{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "factory/change-set",
  "title": "06-verify/change-set.yaml \u2014 files the feature changed, by task (engine)",
  "type": "object",
  "required": [
    "feature",
    "tasks"
  ],
  "properties": {
    "feature": {
      "type": "string"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "satisfies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "files changed in the working tree (git), .factory excluded"
    },
    "outside_plan": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "changed files no done task planned (and not docs or acceptance tests)"
    },
    "scaffold": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "greenfield: the starter files the engine copied; they ship in a chore(scaffold) commit"
    }
  }
}
