{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "factory/prototype-screens",
  "title": ".factory/prototype/screens.yaml \u2014 every screen of the living app prototype (the prototype-designer keeps it)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "screens"
  ],
  "properties": {
    "app": {
      "type": "string"
    },
    "layout": {
      "enum": [
        "sidebar",
        "top-nav"
      ]
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "kebab-case; the page is pages/<id>.html; the same name as the stories' ux.surfaces entry, kebab-cased"
          },
          "title": {
            "type": "string"
          },
          "surface": {
            "type": "string",
            "description": "the ux.surfaces name in the stories"
          },
          "page_type": {
            "enum": [
              "list",
              "detail",
              "form",
              "dashboard",
              "settings",
              "wizard",
              "other"
            ]
          },
          "entity": {
            "type": "string"
          },
          "stories": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^STORY-\\d{4}$"
            }
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^FEAT-\\d{3}$"
            }
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "description": "each state is a data-state=\"<name>\" block in the page and a dev-panel option"
          },
          "status": {
            "enum": [
              "added",
              "changed",
              "unchanged",
              "removed",
              "placeholder"
            ],
            "description": "relative to the current feature; placeholder = a nav entry for a screen not prototyped yet (no page)"
          },
          "nav": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "order": {
                "type": "integer"
              },
              "hidden": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
