{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "factory/stories",
  "title": "stories.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature",
    "stories"
  ],
  "properties": {
    "feature": {
      "type": "string",
      "pattern": "^FEAT-\\d{3}$"
    },
    "stories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "traces",
          "as_a",
          "i_want",
          "so_that",
          "acs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^STORY-\\d{4}$"
          },
          "traces": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^REQ-\\d{4}$"
            },
            "minItems": 1
          },
          "as_a": {
            "type": "string"
          },
          "i_want": {
            "type": "string"
          },
          "so_that": {
            "type": "string"
          },
          "acs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "gherkin"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^AC-\\d{4}$"
                },
                "gherkin": {
                  "type": "string"
                }
              }
            }
          },
          "ux": {
            "type": "object",
            "properties": {
              "surfaces": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "states": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
