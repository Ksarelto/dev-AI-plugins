{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "factory/prototype-report",
  "title": "02b-prototype/prototype-report.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature",
    "screens",
    "spec_delta"
  ],
  "properties": {
    "feature": {
      "type": "string",
      "pattern": "^FEAT-\\d{3}$"
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "file",
          "stories"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "stories": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^STORY-\\d{4}$"
            }
          }
        }
      }
    },
    "spec_delta": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "change",
          "breaking"
        ],
        "properties": {
          "change": {
            "type": "string"
          },
          "breaking": {
            "type": "boolean"
          },
          "affects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
