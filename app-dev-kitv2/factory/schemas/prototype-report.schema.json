{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "factory/prototype-report",
  "title": "02b-prototype/prototype-report.yaml \u2014 the prototype-designer's summary of this feature's prototype increment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature",
    "design_authority",
    "screens",
    "spec_delta"
  ],
  "properties": {
    "feature": {
      "type": "string",
      "pattern": "^FEAT-\\d{3}$"
    },
    "design_authority": {
      "enum": [
        "provided",
        "derived",
        "neutral"
      ],
      "description": "provided: binding brand/design inputs were applied; derived: from the domain and the spec; neutral: the kit's neutral light theme"
    },
    "design_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "files the design came from (inbox, .factory/design/**), and ui-ux-pro-max when it was used"
    },
    "binding": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attribute",
          "value",
          "source",
          "token"
        ],
        "properties": {
          "attribute": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "description": "file:line"
          },
          "token": {
            "type": "string",
            "pattern": "^--[a-z0-9-]+$"
          }
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attribute",
          "reason"
        ],
        "properties": {
          "attribute": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "provided": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 5
          }
        }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "file",
          "stories"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "pattern": "^pages/[a-z0-9-]+\\.html$"
          },
          "stories": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^STORY-\\d{4}$"
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "description": "UI building blocks the screens use, for the architect's reuse decisions",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "screens": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "existing": {
            "type": "boolean",
            "description": "the app already has it (component inventory)"
          }
        }
      }
    },
    "spec_delta": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "change",
          "breaking"
        ],
        "properties": {
          "change": {
            "type": "string",
            "minLength": 5
          },
          "breaking": {
            "type": "boolean",
            "description": "true when the approved spec must change"
          },
          "kind": {
            "enum": [
              "validated",
              "invalidated",
              "discovered"
            ],
            "description": "validated: the prototype confirms an AC; invalidated: an AC does not work as written; discovered: a need no AC covers"
          },
          "affects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
