{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "factory/config",
  "title": "factory.config.yaml (merged with defaults)",
  "type": "object",
  "required": [
    "version",
    "roles",
    "pipeline",
    "budgets",
    "context",
    "policy"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "type": "object"
    },
    "packs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled",
          "pack",
          "stack",
          "owns_paths"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "pack": {
            "type": "string"
          },
          "stack": {
            "type": "string"
          },
          "owns_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "boilerplate": {
            "type": [
              "object",
              "null"
            ]
          },
          "stack_overrides": {
            "type": "object",
            "description": "merged over the stack pack's stack.yaml for this project (package_manager, commands, node_version, …)"
          },
          "path": {
            "type": "string",
            "description": "the role's package directory, relative to the project (default: the project root); its stack commands run there"
          },
          "checks_off": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "role checks and audits (role.yaml gates.checks / gates.audits names) this project turns off, e.g. [conventions] for an app that predates the stack's conventions"
          }
        }
      }
    },
    "pipeline": {
      "type": "object",
      "required": [
        "profiles"
      ],
      "properties": {
        "profile": {
          "type": "string"
        },
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "stages": {
          "type": "object"
        },
        "digest_after": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode_profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tier_profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "auto_tier": {
          "type": "boolean",
          "description": "size a feature at intake and re-check it after requirements (false keeps the entry mode's profile)"
        },
        "size_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "small": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "words": {
                  "type": "integer",
                  "minimum": 0
                },
                "reqs": {
                  "type": "integer",
                  "minimum": 0
                },
                "acs": {
                  "type": "integer",
                  "minimum": 0
                },
                "stories": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "deprecated and ignored (stories are written after the size is decided)"
                },
                "screens": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "patch": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "words": {
                  "type": "integer",
                  "minimum": 0
                },
                "reqs": {
                  "type": "integer",
                  "minimum": 0
                },
                "acs": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "skip_gates": {
          "type": "object",
          "description": "profile -> human gates it does not ask (GATE-C always asks)",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^GATE-[A-Z]$"
            }
          }
        }
      }
    },
    "flow": {
      "type": "object",
      "properties": {
        "policy": {
          "enum": [
            "kanban",
            "iterations"
          ]
        },
        "role_tracks": {
          "enum": [
            "parallel",
            "sequential"
          ]
        }
      }
    },
    "automation": {
      "type": "object",
      "properties": {
        "autopilot": {
          "type": "boolean",
          "description": "auto-approve every human_gate (never a CLARIFY stop) so the pipeline runs unattended through delivery"
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "completeness_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "coverage_changed_lines_min": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "axe_critical_max": {
          "type": "integer",
          "minimum": 0
        },
        "axe_routes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bundle_kb_max": {
          "type": "number",
          "minimum": 0
        },
        "review_blocking": {
          "type": "array",
          "items": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          }
        },
        "task_audit_blocking": {
          "type": "array",
          "items": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          }
        },
        "impl_build": {
          "type": "boolean"
        },
        "task_tests": {
          "enum": [
            "scoped",
            "full"
          ]
        },
        "task_lint": {
          "enum": [
            "scoped",
            "full"
          ]
        },
        "tsc_incremental": {
          "type": "boolean"
        },
        "cache_failures": {
          "type": "boolean"
        },
        "integration_tests": {
          "enum": [
            "run",
            "skip"
          ]
        },
        "allow_skipped_checks": {
          "type": "boolean"
        },
        "early_review": {
          "type": "boolean"
        },
        "gate_concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "tasks_max": {
          "type": "integer",
          "minimum": 1,
          "description": "gate-plan fails too-many-tasks when the plan has more tasks than this"
        },
        "task_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "files_max": {
              "type": "integer",
              "minimum": 1
            },
            "loc_max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "task_limits_by_type": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "files_max": {
                "type": "integer",
                "minimum": 1
              },
              "loc_max": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "tdd": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "required",
                "off"
              ]
            },
            "author": {
              "enum": [
                "builder_two_phase",
                "separate"
              ],
              "description": "builder_two_phase: one builder dispatch writes red tests then the code; separate: test author, then builder"
            },
            "exempt_types": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "exempt_may_satisfy": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pipeline_red": {
              "type": "boolean",
              "description": "deprecated and ignored (pipelined red phases are not implemented); `factory doctor` warns about it"
            }
          }
        },
        "vague_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "budgets": {
      "type": "object"
    },
    "context": {
      "type": "object"
    },
    "model_tiers": {
      "type": "object"
    },
    "policy": {
      "type": "object",
      "properties": {
        "protected_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "intake": {
      "type": "object"
    },
    "delivery": {
      "type": "object"
    },
    "shared_paths": {
      "type": "object"
    }
  }
}
