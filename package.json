{
  "name": "dev-AI-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "Plugin marketplace with reusable skills, rules, commands, and agents for Claude Code and Cursor",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-marketplace.mjs",
    "eval": "node evals/runner.mjs",
    "mock-flow:feature-dev": "node app-dev-kit/feature-dev-kit/skills/feature-dev/scripts/mock-flow.mjs",
    "install:cursor-local": "node scripts/install-cursor-local.mjs",
    "uninstall:cursor-local": "node scripts/install-cursor-local.mjs --uninstall",
    "test:spec-contract": "node scripts/test-spec-contract.mjs",
    "test:incremental": "node scripts/emulate-incremental-app.mjs",
    "test:html-kit": "node --test app-dev-kit/html-generator-kit/skills/generate-html/scripts/"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^6.0.3",
    "yaml": "^2.6.1"
  }
}
