description: Domain leaves, a query read-path, and an HTTP transport. Domains do not import each other. dependency-cruiser enforces the import matrix.
globs: ["**/src/api/**/*.ts", "**/src/domains/**/*.ts", "**/src/queries/**/*.ts", "**/src/composition/**/*.ts", "**/.dependency-cruiser.cjs"]
alwaysApply: false
