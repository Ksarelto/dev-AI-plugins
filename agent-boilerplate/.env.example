# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
HOST=0.0.0.0
PORT=3100
LOG_LEVEL=debug
LOG_PRETTY=true
TRUST_PROXY=loopback

# Matches the `db` service in docker-compose.yml (npm run db:up) — pgvector on port 5433
DATABASE_URL=postgres://app:app@localhost:5433/agent
DATABASE_POOL_MAX=10

# Must equal backend-boilerplate's values: this service verifies the backend's access tokens.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ISSUER=backend-boilerplate
JWT_AUDIENCE=backend-boilerplate-api

# Models via OpenRouter (https://openrouter.ai). Without a key the service starts degraded:
# chat and ingest answer 503, health reports `degraded`.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
APP_URL=http://localhost:3100
APP_NAME=agent-boilerplate
MODEL_CHAT=openai/gpt-4.1-mini
# Optional second provider used when the primary fails (LangChain withFallbacks)
MODEL_CHAT_FALLBACK=
MODEL_EMBED=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2

AGENT_MAX_ITERATIONS=6
RETRIEVAL_TOP_K=5
GUARDRAIL_MODE=block

CORS_ORIGINS=http://localhost:5173
REQUEST_TIMEOUT_MS=90000
SHUTDOWN_TIMEOUT_MS=30000
SHUTDOWN_DRAIN_DELAY_MS=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Optional tracing. LangChain/LangGraph send traces to LangSmith automatically when set.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-boilerplate
